{
  "name": "my-store",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs before static files for these paths: the API, the
    // password-protected admin, and the storefront pages (to apply design settings).
    "run_worker_first": ["/api/*", "/admin*", "/", "/index.html", "/product*", "/cart*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-store-db",
      "database_id": "be77e626-01be-413f-ad46-b763929d3520",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
